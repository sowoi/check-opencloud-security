# Example environment file for check-opencloud-security.
#
# Copy this to /etc/check-opencloud-security/env and adjust the values,
# then reference it from the systemd unit (see check-opencloud-security.service)
# or a cron job (see ../cron/check-opencloud-security.cron).
#
# All options accepted on the command line can also be set here using their
# COS_ prefixed environment variable name. An explicit CLI flag always wins
# over the environment variable.

# Required: the OpenCloud instance to scan. A hostname, an IP address or a
# full URL; ':port' and IPv6 in brackets are accepted.
COS_HOST=opencloud.example.com

# Optional: HTTP/HTTPS proxy used for both the scan and the release feed.
#COS_PROXY=http://proxy.example.com:3128

# Optional: verbose debug logging.
#COS_DEBUG=false

# Optional: retry/backoff tuning for transient network errors.
#COS_RETRIES=2
#COS_BACKOFF_FACTOR=0.5

# HTTP timeout in seconds for each request.
#COS_TIMEOUT=10

# Rating thresholds (0-5, where 5 == A+ and 0 == F). A rating at or below
# the value reports the corresponding state. Note that a single critical
# finding caps the rating at 2 (D), which is WARNING by default - set
# COS_CRITICAL=2 if such a finding should page instead.
#COS_WARNING=3
#COS_CRITICAL=1

# Also report missing hardening measures and security headers, raising an
# otherwise OK result to WARNING.
#COS_CHECK_HARDENING=false

# Optional webhook notification. Unset (the default) disables the feature.
# COS_WEBHOOK_ON selects the lowest state that notifies: critical, warning,
# unknown or always.
#COS_WEBHOOK_URL=https://hooks.example.com/opencloud
#COS_WEBHOOK_ON=critical
#COS_WEBHOOK_TIMEOUT=10
# Extra headers for the webhook request, separated by ';'.
#COS_WEBHOOK_HEADERS=X-Auth-Token: <token>; X-Env: prod

# ---------------------------------------------------------------------------
# The built-in scanner. OpenCloud has no scan API, so every check runs here.
# ---------------------------------------------------------------------------

# Path to a YAML configuration file. Values there are used for every option
# that is not set on the command line or in the environment.
#COS_CONFIG_FILE=/etc/check-opencloud-security/config.yml

# OpenCloud terminates TLS itself, and 'opencloud init' creates a self-signed
# certificate. Set this to false for such a deployment; the scan then still
# runs but the untrusted certificate is no longer reported as a finding.
#COS_SCANNER_VERIFY_TLS=true
# Use http only for testing.
#COS_SCANNER_SCHEME=https
# OpenCloud's own port when it is not behind a reverse proxy.
#COS_SCANNER_TARGET_PORT=9200

# Run the additional checks (TLS, exposed files, headers, WebDAV, ...).
#COS_SCANNER_EXTRA_CHECKS=true
# Let a failed additional check lower the rating.
#COS_SCANNER_EXTRA_CHECKS_RATING=true
# Warn this many days before the TLS certificate expires.
#COS_SCANNER_TLS_MIN_DAYS=21

# The OpenCloud services expose /metrics, /config and /debug/pprof on separate
# debug ports. They listen on loopback by default, so one that answers from
# the outside is a real finding. Each probe is a TCP connect.
#COS_SCANNER_CHECK_DEBUG_PORTS=true
#COS_SCANNER_DEBUG_PORTS=9205,9141,9124,9134,9239
#COS_SCANNER_DEBUG_PORT_TIMEOUT=3

# Rate major releases that no longer receive updates as F (end of life).
#COS_SCANNER_USE_RELEASE_SCHEDULE=true
#COS_SCANNER_SUPPORTED_MAJORS=7,6,5

# Extra advisory files / feed for the vulnerability matching.
#COS_SCANNER_VULNERABILITY_DB=/etc/check-opencloud-security/advisories.json
#COS_SCANNER_VULNERABILITY_FEED=https://example.com/opencloud-advisories.json

# ---------------------------------------------------------------------------
# Update check against the OpenCloud release feed on GitHub.
# ---------------------------------------------------------------------------

# auto (default), feed, pinned, bundled or off.
#COS_RELEASES_MODE=auto
#COS_RELEASES_FEED_URL=https://api.github.com/repos/opencloud-eu/opencloud/releases/latest
# A token - a fine-grained one without any permission is enough - only raises
# the anonymous rate limit of the feed.
#COS_RELEASES_TOKEN_FILE=/run/secrets/releases_token
# Compare against this version instead of asking GitHub (mode 'pinned').
#COS_RELEASES_LATEST_VERSION=7.2.0

# Raise an otherwise OK result to WARNING when an update is available.
#COS_UPDATE_WARNING=false

# Disable the update check completely.
#COS_NO_UPDATE_CHECK=true
