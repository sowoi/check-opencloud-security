# syntax=docker/dockerfile:1
#
# The public web application: FastAPI in front, an ARQ worker behind, Redis in
# the middle. One image serves as both the web service and the worker - they
# run the same code and differ only in the command, which keeps them from
# drifting apart between deployments.
#
#   cd docker && docker compose up --build
#
# The build context is the repository root, not this directory:
#
#   docker build -f docker/Dockerfile.web -t check-opencloud-security-web .
#
# The plugin's own image is built from `docker/Dockerfile`. This one is
# deliberately separate: a monitoring host has no use for a web server, and
# the artefact published to PyPI carries neither `webapp/` nor `frontend/`.

FROM python:3.15-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/

WORKDIR /src

COPY pyproject.toml uv.lock README.md LICENSE ./
COPY check_opencloud_security.py ./
COPY opencloud_local_scan ./opencloud_local_scan

# The dependencies come from uv.lock, with their hashes, and not from whatever
# PyPI serves on the day the image is built. The lock is what CI tests and
# what pip-audit and the SBOM describe; an image resolving afresh would ship
# versions none of them ever saw.
RUN uv build --wheel --out-dir /dist \
    && uv export --frozen --no-default-groups --no-emit-project \
        --extra web --extra mcp --extra signing \
        --format requirements-txt --output-file /dist/requirements.txt


FROM python:3.15-slim

LABEL org.opencontainers.image.title="check-opencloud-security-web" \
      org.opencontainers.image.description="Public security scan service for OpenCloud instances" \
      org.opencontainers.image.source="https://github.com/sowoi/check-opencloud-security" \
      org.opencontainers.image.licenses="GPL-3.0-only"

COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/
COPY --from=builder /dist/*.whl /dist/requirements.txt /tmp/

# The wheel plus the 'web', 'mcp' and 'signing' extras. The scanner comes from
# the wheel exactly as it does on PyPI, so the service can never be running a
# patched copy of the checks. 'mcp' is what serves /mcp; without it the
# endpoint is simply not mounted and everything else still works.
#
# The locked set goes in first with every hash checked, then the wheel with
# --no-deps, so nothing this step installs was resolved here.
RUN set -eu \
    && uv pip install --system --no-cache --require-hashes -r /tmp/requirements.txt \
    && uv pip install --system --no-cache --no-deps /tmp/*.whl \
    && rm -rf /tmp/*.whl /tmp/requirements.txt /bin/uv \
    && useradd --no-create-home --shell /usr/sbin/nologin --uid 10001 scanner

# Where COS_WEB_AUDIT_LOG_FILE points when a deployment asks for an audit trail
# that survives the container. Nothing is written here unless it does - but the
# directory has to exist, and has to be owned by the unprivileged user, before
# the volume is mounted: Docker copies the mount point's ownership into a fresh
# named volume, and a directory created by the mount instead would belong to
# root and be unwritable by the process that needs it.
#
# The second is where COS_WEB_ADMIN_UPDATE_DIR points: the mount point of the
# tmpfs a release installed from the operator's area is unpacked onto (ADR 0070).
RUN install -d -o 10001 -g 10001 -m 0700 \
        /var/log/opencloud-scan /var/lib/opencloud-scan/update

WORKDIR /app

# The two directories that are *not* in the wheel, copied in as application
# code rather than as an installed package.
COPY webapp ./webapp
COPY frontend ./frontend

# COPY keeps the permissions the files had in the build context, and a
# developer checkout is not world readable. The unprivileged user has to be
# able to read the code it runs, and nothing here is ever written to.
RUN chmod -R a=rX /app

USER 10001

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    COS_WEB_REDIS_URL=redis://redis:6379/0

EXPOSE 8811

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8811/healthz')"]

# Overridden by the worker service in docker/docker-compose.yml, which runs
# `python -m webapp.tasks` instead.
#
# No `--proxy-headers --forwarded-allow-ips "*"`: that lets uvicorn rewrite the
# peer address from an X-Forwarded-For header anybody can send, below the app,
# so every request would land in its own rate-limit bucket and the client limit
# would never fire. The app reads that header itself, but only when the
# operator sets COS_WEB_TRUST_FORWARDED_FOR=true, which is the switch that
# should decide it. `--no-access-log` keeps the scan uuid - which is the
# capability token for the result - and the client address out of the log.
CMD ["uvicorn", "webapp.app:app", "--host", "0.0.0.0", "--port", "8811", \
     "--no-server-header", "--no-access-log"]
