# The generated search indexes. They are a pure function of the templates, the
# catalogues and the version, and they are also checked in, so two branches
# that touch any of those conflict on the same lines with nothing for a person
# to decide. The driver rebuilds the file instead of merging it - which is what
# the release workflow would produce anyway, and the only workflow allowed to.
# Register it once per clone: python scripts/setup_git_merge_drivers.py
# See CONTRIBUTING.md, "Generated files and merge conflicts".
frontend/static/search-index.json merge=search-index linguist-generated
frontend/static/search-index.de.json merge=search-index linguist-generated
frontend/static/search-index.es.json merge=search-index linguist-generated
frontend/static/search-index.fr.json merge=search-index linguist-generated

secrets/ export-ignore
tests/ export-ignore
scripts/ export-ignore
adr/ export-ignore
img/ export-ignore
ansible/ export-ignore
contrib/ export-ignore
docker-compose.yml export-ignore
.dockerignore export-ignore
.github/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
AGENTS.md export-ignore
DESIGN.md export-ignore
CONTRIBUTING.md export-ignore
noxfile.py export-ignore
mypy.ini export-ignore
